# ─────────────────────────────────────────────────────────────────────────────
# ScopeShield environment — copy to `.env` and fill in. NEVER commit the real .env.
# Every value here is a placeholder. Nothing secret belongs in the repo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of this API (used in links inside emails)
API_PUBLIC_URL=http://localhost:4000
# Public URL of the web app (used for approval links, password resets)
WEB_PUBLIC_URL=http://localhost:5173
# Comma-separated allowed browser origins for credentialed requests
CORS_ORIGINS=http://localhost:5173
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-48-random-bytes-base64url
# Set to "true" only when running behind TLS in production (forces Secure cookies)
COOKIE_SECURE=false

# ── Database ─────────────────────────────────────────────────────────────────
# Production: MongoDB Atlas or self-hosted. Example:
# MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/scopeshield?retryWrites=true&w=majority
# Local dev without an external server: leave MONGODB_URI empty and the app will
# boot a bundled MongoDB via mongodb-memory-server, persisting to ./data/mongo
# (set USE_EMBEDDED_DB=true to force it).
MONGODB_URI=
USE_EMBEDDED_DB=false

# ── Document storage (private) ───────────────────────────────────────────────
STORAGE_DRIVER=local          # local | s3 (s3 is an interface stub; see docs)
STORAGE_LOCAL_DIR=./data/uploads
MAX_UPLOAD_MB=15
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=

# ── Email ────────────────────────────────────────────────────────────────────
MAIL_DRIVER=file              # file (writes .eml to ./data/mail) | smtp | resend | console
MAIL_FROM="ScopeShield <no-reply@example.com>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# RESEND_API_KEY=

# ── AI (all optional — the product is fully functional without any key) ──────
# Provider: heuristic (default, no network) | openai | anthropic
AI_PROVIDER=heuristic
AI_MONTHLY_BUDGET_USD=25
AI_MAX_INPUT_CHARS=24000
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint (Groq, OpenRouter, local llama.cpp, vLLM):
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ── Policy defaults (overridable per organization in the UI) ─────────────────
APPROVAL_TOKEN_TTL_DAYS=14
DEFAULT_CURRENCY=USD
